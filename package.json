{
  "name": "av-opencode-plugins",
  "version": "0.4.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "scripts",
    "packages/python-developer/dist",
    "packages/code-review/dist",
    "packages/frontend-developer/dist",
    "packages/skill-utils/package.json",
    "packages/skill-utils/dist",
    "packages/skill-registry/dist",
    "packages/swift-developer/dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@appverk/opencode-skill-utils": "workspace:*",
    "@opencode-ai/plugin": "^1.14.19",
    "jsonc-parser": "^3.3.1"
  },
  "overrides": {
    "uuid": ">=14.0.0"
  },
  "scripts": {
    "preinstall": "bun scripts/check-package-manager.mjs",
    "build:root": "tsup --config tsup.root.config.ts && bun scripts/copy-root-assets.mjs",
    "build:skill-utils": "bun --filter @appverk/opencode-skill-utils build",
    "build:dependents": "bun --filter @appverk/opencode-python-developer --filter @appverk/opencode-code-review --filter @appverk/opencode-frontend-developer --filter @appverk/opencode-skill-registry --filter @appverk/opencode-swift-developer build",
    "build": "bun run build:root && bun run build:skill-utils && bun run build:dependents",
    "test": "bun run build && bun run test:nobuild",
    "test:nobuild": "vitest run --config vitest.config.ts && bun --filter '@appverk/opencode-*' test:nobuild",
    "typecheck": "bun run build:skill-utils && bun run typecheck:nobuild",
    "typecheck:nobuild": "tsc -p tsconfig.json --noEmit && bun --filter '@appverk/opencode-*' typecheck",
    "check": "bun run build && bun run typecheck:nobuild && bun run test:nobuild",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify-dist": "bun scripts/verify-dist-sync.mjs",
    "verify-no-review-ids": "bun scripts/verify-no-review-ids.mjs",
    "verify-version-tag": "bun scripts/verify-version-tag.mjs",
    "verify-versions": "bun scripts/verify-workspace-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.2.6"
  },
  "types": "./dist/index.d.ts"
}
